# HYVR — local env template for DA Seed (tenant-config.mjs / seed-da.mjs / ims-token.mjs).
# Copy to `.env` in this folder and fill in real values. `.env` is git-ignored (root
# .gitignore: `.env` / `.env.*`) — never commit real secrets. This file (.env.example)
# contains NO real values and is safe to commit.
#
# Usage (Node 22 built-in env-file loader, no dependency):
#   node --env-file-if-exists=.env tools/ims-token.mjs
#   DRY_RUN=false node --env-file-if-exists=.env tools/tenant-config.mjs
#   DRY_RUN=false node --env-file-if-exists=.env tools/seed-da.mjs
# or via the npm scripts: npm run ims:token:local / tenant:config:local / seed:da:local
#
# See ../docs/onboarding/da-content-onboarding-and-cors.md for the full design + auth matrix.

# --- Adobe IMS auth (shared/services/ims-auth) — pick ONE path ---

# Path 1: explicit token from an authenticated session (fastest for local testing)
IMS_ACCESS_TOKEN=
# Legacy alias, also accepted:
DA_TOKEN=

# Path 2: OAuth Server-to-Server (client_credentials) — matches the CI secrets
IMS_CLIENT_ID=
IMS_CLIENT_SECRET=
IMS_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext,read_pc.dma_aem_ams
IMS_ORG_ID=

# Path 3: aio CLI session — no env var needed; run `aio login` first (requires @adobe/aio-cli)

# --- Tenant (DA + EDS) ---
DA_ORG=clporgs
DA_SITE=hyvr-eds
AEM_REF=dev
DA_ENV=dev

# --- Optional overrides ---
# AEM Assets delivery host (defaults to delivery-<org>-<env>.adobeaemcloud.com)
ASSETS_DELIVERY_HOST=
# Where DA reads site config — CONFIRM against your tenant (default /.da/config)
DA_CONFIG_PATH=
# aem.live admin base — CONFIRM (admin.hlx.page vs admin.aem.live)
AEM_ADMIN_BASE=
# Bearer token for aem.live preview/publish admin calls, if your tenant requires one
AEM_ADMIN_AUTH=
# Seed a different source tree (e.g. a demo/vertical) instead of the blueprint root
SRC_DIR=

# --- Run behaviour ---
# "false" to actually write; anything else (or unset) = dry run, no network calls
DRY_RUN=true
# "true" to also publish (go live) after preview; only meaningful when DRY_RUN=false
PUBLISH=false
