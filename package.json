{
  "name": "hyvr-eds",
  "version": "1.0.0",
  "private": true,
  "description": "HYVR — Blueprint 1: AEM Edge Delivery Services + DA.live reference implementation",
  "type": "module",
  "scripts": {
    "serve": "node tools/server.mjs",
    "serve:https": "node tools/server.mjs",
    "ims:token": "node tools/ims-token.mjs",
    "ims:token:local": "node --env-file-if-exists=.env tools/ims-token.mjs",
    "tenant:config": "node tools/tenant-config.mjs",
    "tenant:config:local": "node --env-file-if-exists=.env tools/tenant-config.mjs",
    "seed:da": "node tools/seed-da.mjs",
    "seed:da:local": "node --env-file-if-exists=.env tools/seed-da.mjs",
    "up": "aem up",
    "tokens": "node ../design-system/scripts/build-tokens.mjs --out styles && node -e \"import('node:fs').then(fs=>fs.copyFileSync('styles/tokens.css','styles/tokens.css'))\"",
    "assets": "node tools/generate-placeholders.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "test": "node --test test/tokens.test.mjs test/content.test.mjs test/lead.test.mjs test/ims-auth.test.mjs test/da-doc-transform.test.mjs",
    "test:a11y": "pa11y-ci --sitemap http://localhost:3001/sitemap.xml || echo 'run against a running preview'",
    "psi": "node tools/psi-check.mjs"
  },
  "devDependencies": {
    "@adobe/aem-cli": "^16.10.0",
    "eslint": "^9.13.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.0",
    "pa11y-ci": "^3.1.0"
  },
  "engines": { "node": ">=22" },
  "license": "UNLICENSED"
}
